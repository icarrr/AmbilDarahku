# Docker Compose auto-reads this file
# Override any values as needed
# Copy to .env and edit

# PostgreSQL
DB_USER=ambildarahku
DB_PASSWORD=ambildarahku
DB_NAME=ambildarahku

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# JWT
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Admin seed (creates super admin on first startup)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=admin123
# SEED_ADMIN_PHONE=6281234567890

# Ports
SERVER_PORT=8080
FRONTEND_PORT=3000

# Backend URL (internal Docker network)
BACKEND_URL=http://backend:8080

# Domain for sitemap/SEO
DOMAIN=ambildarahku.demithub.web.id

# Frontend public API path (Next.js rewrites to backend)
NEXT_PUBLIC_API_URL=/api/v1

# SMTP for email verification & password reset
# Leave empty to skip sending emails (verification auto-approved)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ambildarahku.id
APP_URL=http://localhost:3000
