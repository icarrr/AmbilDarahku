# Copy to .env and edit

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=ambildarahku
DB_PASSWORD=ambildarahku
DB_NAME=ambildarahku
DB_SSLMODE=disable

# Vercel Blob (get token from https://vercel.com/dashboard/stores)
BLOB_READ_WRITE_TOKEN=

# JWT
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Admin seed (creates super admin on first startup)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PHONE=

# Public coordinator contact (E.164, e.g. 6281234567890). All "Hubungi" wa.me
# buttons point here so only the coordinator reaches donors/requesters.
# Empty = contact buttons hidden.
NEXT_PUBLIC_COORDINATOR_PHONE=

# Ports
FRONTEND_PORT=3000

# Domain for sitemap/SEO
DOMAIN=ambildarahku.demithub.web.id

# Frontend public API path (handled by Next.js API routes)
NEXT_PUBLIC_API_URL=/api/v1

# SMTP for email verification & password reset
# Leave empty to skip sending emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ambildarahku.id
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (replaces direct PostgreSQL in API routes)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Vercel Cron secret (optional — set in Vercel project env vars)
CRON_SECRET=

# External Kawan Sedarah Supabase anon key (used by discovery runners)
KS_ANON_KEY=

# Automatic scraping scheduler (Supabase pg_cron → pg_net, no external cron)
# Set SCRAPE_TARGET_URL to the deployed endpoint to enable the job:
#   SCRAPE_TARGET_URL=https://ambildarahku.vercel.app/api/v1/discover
# Interval is configured at migrate time (resched: re-run npm run migrate).
# CRON_SECRET must ALSO be set in Vercel runtime env, or Vercel cron + pg_net posts are rejected.
SCRAPE_TARGET_URL=
SCRAPE_INTERVAL_MINUTES=60

# x-vercel-cron-schedule expression trusted by /api/v1/discover
# Must match the schedule in vercel.json (once daily on Hobby plans).
VERCEL_CRON_EXPR=0 18 * * *

# Direct PostgreSQL URL (migrations + admin analytics SQL aggregation)
DATABASE_URL=
